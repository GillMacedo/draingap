{
    "apiVersion": "v1",
    "kind": "List",
    "items": [
        {
            "apiVersion": "apps/v1",
            "kind": "Deployment",
            "metadata": {
                "name": "api"
            },
            "spec": {
                "selector": {
                    "matchLabels": {
                        "app": "api"
                    }
                },
                "template": {
                    "metadata": {
                        "labels": {
                            "app": "api"
                        }
                    },
                    "spec": {
                        "terminationGracePeriodSeconds": 30,
                        "containers": [
                            {
                                "name": "api",
                                "image": "registry.example.com/api:1.0.0",
                                "lifecycle": {
                                    "preStop": {
                                        "sleep": {
                                            "seconds": 5
                                        }
                                    }
                                }
                            }
                        ]
                    }
                }
            }
        }
    ]
}
